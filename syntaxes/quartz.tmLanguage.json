{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quartz",
  "scopeName": "source.quartz",
  "fileTypes": [
    "qz",
    "qzi"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.quartz",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.quartz",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.quartz"
            }
          }
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.quartz",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.quartz"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.quartz"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "attributes": {
      "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "name": "meta.attribute.quartz",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.quartz"
        },
        "2": {
          "name": "storage.type.annotation.quartz"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.quartz",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.quartz"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.quartz"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.quartz",
          "begin": "\"",
          "end": "(\")|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.quartz"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.quartz"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.quartz",
          "match": "\\\\(?:[ntr0\\\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,7}\\})"
        },
        {
          "name": "invalid.illegal.escape.quartz",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.quartz",
      "contentName": "source.quartz.embedded",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.quartz"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.quartz"
        }
      },
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.quartz"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.quartz"
        }
      },
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.quartz",
      "match": "(')(?:\\\\(?:[ntr0\\\\\\\"'{}]|u\\{[0-9A-Fa-f]{1,7}\\})|[^'\\\\\\n])(')",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.quartz"
        },
        "2": {
          "name": "punctuation.definition.string.end.quartz"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.quartz",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.quartz",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.quartz",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.quartz",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.quartz",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.quartz"
            },
            "2": {
              "name": "entity.name.function.quartz"
            }
          }
        },
        {
          "match": "\\b(struct|state|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.quartz"
            },
            "2": {
              "name": "entity.name.type.quartz"
            }
          }
        },
        {
          "match": "\\b(package|import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.import.quartz"
            },
            "2": {
              "name": "entity.name.namespace.quartz"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.quartz"
            },
            "2": {
              "name": "variable.other.constant.quartz"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quartz",
          "match": "\\b(if|else|match|for|in|while|break|continue|return|wait|at|scope|every)\\b"
        },
        {
          "name": "storage.type.function.quartz",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.quartz",
          "match": "\\b(struct|state|enum|trait|impl|let|var|const|ref)\\b"
        },
        {
          "name": "storage.modifier.quartz",
          "match": "\\b(pub|internal|private|suspend)\\b"
        },
        {
          "name": "keyword.other.import.quartz",
          "match": "\\b(package|import)\\b"
        },
        {
          "name": "keyword.operator.type.quartz",
          "match": "\\b(as|is)\\b"
        },
        {
          "name": "constant.language.boolean.quartz",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.quartz",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.quartz",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.quartz",
          "match": "\\b(int|float|byte|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|str|void)\\b"
        },
        {
          "name": "support.type.quartz",
          "match": "\\b(Bytes|List|Map|Set|Result|Self)\\b"
        },
        {
          "name": "variable.other.constant.quartz",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z])"
        },
        {
          "name": "entity.name.type.quartz",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\(|::<)",
      "captures": {
        "1": {
          "name": "entity.name.function.call.quartz"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.quartz",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.assignment.compound.quartz",
          "match": "(?:<<|>>|[-+*/%&|^])="
        },
        {
          "name": "keyword.operator.comparison.quartz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.quartz",
          "match": "="
        },
        {
          "name": "keyword.operator.null.quartz",
          "match": "\\?\\?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.range.quartz",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.logical.quartz",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.quartz",
          "match": "<<|[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.quartz",
          "match": "[-+*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.quartz",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.quartz",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.quartz",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.quartz",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.quartz",
          "match": ";"
        },
        {
          "name": "punctuation.section.braces.quartz",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.quartz",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.quartz",
          "match": "[()]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.quartz",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
