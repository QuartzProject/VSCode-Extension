{
  "name": "quartz-lang",
  "displayName": "Quartz",
  "description": "Syntax highlighting, language server and debugger support for the Quartz programming language",
  "version": "0.1.0",
  "publisher": "quartzlang",
  "license": "MIT",
  "homepage": "https://quartzlang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuartzProject/VSCode-Extension.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "quartz",
    "qz",
    "qzi"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:quartz",
    "onDebugResolve:quartz",
    "onDebugDynamicConfigurations:quartz"
  ],
  "scripts": {
    "sync-grammar": "node scripts/sync-grammar.mjs"
  },
  "contributes": {
    "languages": [
      {
        "id": "quartz",
        "aliases": [
          "Quartz",
          "quartz"
        ],
        "extensions": [
          ".qz",
          ".qzi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quartz",
        "scopeName": "source.quartz",
        "path": "./syntaxes/quartz.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "quartz.restartServer",
        "title": "Quartz: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Quartz",
      "properties": {
        "quartz.server.path": {
          "type": "string",
          "default": "quartz-lsp",
          "description": "Path to the quartz-lsp executable. The default uses the one bundled with the extension, or quartz-lsp on PATH."
        },
        "quartz.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server for diagnostics, hover, go to definition, symbols, completion and formatting."
        },
        "quartz.cli.path": {
          "type": "string",
          "default": "quartz",
          "description": "Path to the quartz executable, used to debug (`quartz debug --dap`). The default uses the one bundled with the extension, or quartz on PATH."
        }
      }
    },
    "breakpoints": [
      {
        "language": "quartz"
      }
    ],
    "debuggers": [
      {
        "type": "quartz",
        "label": "Quartz",
        "languages": [
          "quartz"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "A .qz file, a package folder or a .qzb module.",
                "default": "${file}"
              },
              "entry": {
                "type": "string",
                "description": "The function to run.",
                "default": "main"
              },
              "tests": {
                "type": "boolean",
                "description": "Run the @test functions instead of the entry function.",
                "default": false
              },
              "filter": {
                "type": "string",
                "description": "With tests: run only the tests whose name contains this text."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line that runs.",
                "default": false
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "More `suspend fn`s to start as tasks next to the entry; each one is a thread in the call stack.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quartz",
            "request": "launch",
            "name": "Run current file",
            "program": "${file}"
          },
          {
            "type": "quartz",
            "request": "launch",
            "name": "Run tests",
            "program": "${workspaceFolder}",
            "tests": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Quartz: Run current file",
            "description": "Debug the file in the editor",
            "body": {
              "type": "quartz",
              "request": "launch",
              "name": "Run current file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Quartz: Run tests",
            "description": "Debug the @test functions of the folder",
            "body": {
              "type": "quartz",
              "request": "launch",
              "name": "Run tests",
              "program": "^\"\\${workspaceFolder}\"",
              "tests": true
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
